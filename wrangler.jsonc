{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pharmacy-rx-predictor",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "observability": { "enabled": true },

  "containers": [
    {
      "class_name": "StreamlitContainer",
      "image": "./Dockerfile",
      // pandas/openpyxl/folium を動かし、ナビィ詳細を8並列で取得するため lite では足りない。
      // メモリ不足で落ちる場合は standard-2 以降に上げる。
      "instance_type": "standard-1",
      // Streamlit のセッションはプロセス内メモリのため、インスタンスは1つに固定する。
      // （Streamlit 自体は1プロセスで複数ブラウザセッションを同時に扱える）
      "max_instances": 1
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "APP", "class_name": "StreamlitContainer" }]
  },

  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StreamlitContainer"] }]
}
